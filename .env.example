# Получить на https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# Файл с аккаунтами (рекомендуется для 2+ аккаунтов)
ACCOUNTS_FILE=accounts.json

# Пауза между аккаунтами в одном цикле (секунды)
DELAY_BETWEEN_ACCOUNTS=300

# Пауза после полного цикла всех аккаунтов (секунды)
BREAK_AFTER_CYCLE=10800

# Уровень логов: INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Ниже только если НЕ используете accounts.json (1 аккаунт) ---
# SESSION_NAME=session
# SOURCE_CHAT=your_channel_username
# SOURCE_MESSAGE_ID=13
# DELAY_BETWEEN_CHATS=120
# REQUIRE_ADMIN=true
# ALLOWED_CHATS=chat1,chat2
