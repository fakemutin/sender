# Получить на https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# Имя файла сессии (номер телефона или любое имя)
SESSION_NAME=session

# Источник сообщения для рассылки
SOURCE_CHAT=your_channel_username
SOURCE_MESSAGE_ID=13

# Пауза между чатами (секунды)
DELAY_BETWEEN_CHATS=120

# Пауза после полного цикла (секунды)
BREAK_AFTER_CYCLE=10800

# true = только группы/каналы, где вы админ или создатель
REQUIRE_ADMIN=true

# Опционально: только эти чаты (username или id через запятую). Пусто = все разрешённые.
# ALLOWED_CHATS=chat1,chat2,-1001234567890

# --- Опционально: несколько аккаунтов (если SESSION_NAME пустой) ---
# ACCOUNTS_FILE=accounts.json
# PARALLEL_ACCOUNTS=true
# DELAY_BETWEEN_ACCOUNTS=300
# LOG_LEVEL=INFO
